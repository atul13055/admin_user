<div class="container mt-4">
  <div class="row">
    <% @packages.each do |package| %>
      <div class="col-md-4">
        <div class="card shadow-lg rounded">
          <div class="card-header text-white text-center" style="background: linear-gradient(45deg, #3f51b5, #2196f3);">
            <h5 class="mb-0"><%= package.name %></h5>
          </div>
          <div class="card-body">
           <p><strong>Description:</strong> <%= package.description.html_safe %></p>
            <hr>
            <p><strong>Pricing Details:</strong></p>
            <ul class="list-unstyled">
              <% package.pricings.each_with_index do |p, index| %>
                <% country = ISO3166::Country[p.country] %>
                <% flag = country&.emoji_flag || "🏳️" %>
                <% country_name = country.translations['en'] || p.country %>
                <% currency = country.currency_code || "N/A" %>
                <li>
                  <strong><%= index + 1 %>.</strong> <%= flag %> 
                  <strong><%= country_name %></strong> - 
                  <strong><%= currency %>:</strong> <%= p.price %>
                </li>
              <% end %>
            </ul>
            <hr>
            <%= link_to "Subscribe Now", new_user_path(package_id: package.id), class: "btn btn-primary" %>
            <%# <a href="#" class="btn btn-primary btn-block">Subscribe Now</a> %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
