<div class="container mt-5">
  <div class="text-center mb-4">
    <h2 class="fw-bold" style="color: #3f51b5;">Members Plans</h2>
    <hr class="w-25 mx-auto" style="border-top: 3px solid #2196f3;">
  </div>

  <div class="row justify-content-center">
    <% @packages.each do |package| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-lg border-0 rounded-3">
          <div class="card-header text-white text-center py-3" 
               style="background: linear-gradient(45deg, #3f51b5, #2196f3); border-radius: 10px 10px 0 0;">
            <h5 class="mb-0 fw-bold"><%= package.name %></h5>
          </div>
          <div class="card-body p-4">
            <p><strong>Description:</strong> <%= package.description.html_safe %></p>
            <hr>
            <p class="fw-bold text-primary">Pricing Details:</p>
            <ul class="list-unstyled">
              <% package.pricings.each_with_index do |p, index| %>
                <% country = ISO3166::Country[p.country] %>
                <% flag = country&.emoji_flag || "🏳️" %>
                <% country_name = country.translations['en'] || p.country %>
                <% currency = country.currency_code || "N/A" %>
                <li class="mb-2">
                  <span class="fw-bold"><%= index + 1 %>.</span> 
                  <span class="me-2"><%= flag %></span> 
                  <span class="fw-bold"><%= country_name %></span> - 
                  <span class="text-success fw-bold"><%= currency %>:</span> 
                  <span class="text-dark"><%= p.price %></span>
                </li>
              <% end %>
            </ul>
            <hr>
            <div class="text-center">
              <%= link_to "Subscribe Now", new_user_path(package_id: package.id), class: "btn btn-primary btn-lg w-100 fw-bold" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
